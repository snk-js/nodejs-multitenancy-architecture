{
  "name": "trellis",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file-if-exists=.env node_modules/.bin/node-pg-migrate --migrations-dir migrations up",
    "migrate:down": "node --env-file-if-exists=.env node_modules/.bin/node-pg-migrate --migrations-dir migrations down"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.0"
  }
}
