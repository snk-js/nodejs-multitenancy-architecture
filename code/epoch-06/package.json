{
  "name": "trellis",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "migrate": "node --env-file-if-exists=.env node_modules/.bin/node-pg-migrate --migrations-dir migrations up",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.test --test src/services/*.test.ts test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "argon2": "^0.41.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.8.0"
  }
}
