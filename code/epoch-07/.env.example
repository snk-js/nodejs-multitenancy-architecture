PORT=3000
NODE_ENV=development
# The APP connects as trellis_app — subject to RLS, least privilege.
DATABASE_URL=postgres://trellis_app:trellis_app@localhost:5432/trellis
# MIGRATIONS connect as the owner — DDL rights. Two roles, two jobs.
MIGRATIONS_DATABASE_URL=postgres://trellis:trellis@localhost:5432/trellis
