{
  "name": "trellis",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file-if-exists=.env node_modules/.bin/node-pg-migrate --migrations-dir migrations up",
    "migrate:down": "node --env-file-if-exists=.env node_modules/.bin/node-pg-migrate --migrations-dir migrations down"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "argon2": "^0.41.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.0"
  }
}
